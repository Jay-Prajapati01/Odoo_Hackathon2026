# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/assetflow

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=localhost
SECURE_COOKIE=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Logging
LOG_LEVEL=info

# Signup auto-activation (set to false to keep new users 'pending')
SIGNUP_AUTO_ACTIVATE=true

# Initial Admin (created on first boot if set)
INITIAL_ADMIN_EMAIL=admin@assetflow.com
INITIAL_ADMIN_PASSWORD=Admin@1234
